#!/usr/bin/env ruby
$LOAD_PATH.unshift File.expand_path("../lib", __dir__)
require "january"

begin
  January::CLI.start(ARGV)
rescue January::Error => e
  warn "january: #{e.message}"
  exit 1
rescue SystemCallError => e
  warn "january: could not access your data (#{e.message})"
  exit 1
rescue Interrupt
  warn
  exit 130
end
